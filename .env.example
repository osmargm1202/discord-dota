# =============================================================================
# OBLIGATORIO — sin estos el bot no arranca
# =============================================================================

# Token del bot de Discord: https://discord.com/developers/applications
DISCORD_TOKEN=

# ID del servidor de Discord (Clic derecho en server → Copiar ID, necesitas Modo Desarrollador)
SERVER_ID=

# Token de Stratz: https://stratz.com/api
STRATZ_TOKEN=

# ID del canal donde llegan las notificaciones de partidas
# Puedes dejarlo vacío y configurarlo con /dota channel desde Discord
NOTIFICATION_CHANNEL_ID=

# =============================================================================
# POSTGRESQL — contraseña es lo único que debes cambiar
# =============================================================================

POSTGRES_DB=dotabot
POSTGRES_USER=dotabot
POSTGRES_PASSWORD=cambia_esta_contrasena

# Para docker-compose usar el nombre del contenedor (no localhost)
POSTGRES_DSN=postgres://dotabot:cambia_esta_contrasena@discord-dota-postgres:5432/dotabot?sslmode=disable

# =============================================================================
# MINIO — cambia las credenciales
# =============================================================================

MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=cambia_esta_contrasena_minio

# Para docker-compose usar el nombre del contenedor
MINIO_ENDPOINT=discord-dota-minio:9000

MINIO_BUCKET=dota-rankings

# URL pública donde MinIO está expuesto (via CloudFlare tunnel en producción)
MINIO_PUBLIC_URL=https://dota-s3.fifrex.com

# =============================================================================
# RANKING — canal donde se postean los 3 mensajes fijos de ranking
# =============================================================================

RANKING_CHANNEL_ID=1519494823642398852

# =============================================================================
# BACKFILL — descarga histórica de partidas al arrancar
# =============================================================================

# Año desde el que descargar partidas (1 de enero de ese año)
BASE_YEAR=2026

# Delay entre llamadas a Stratz durante el backfill (ms). 700 = ~85 req/min (límite ~100)
BACKFILL_DELAY_MS=700

# =============================================================================
# OPCIONALES — tienen valores por defecto razonables
# =============================================================================

# Minutos entre verificaciones de partidas nuevas (1-60, default 1)
REFRESH_RATE=1

# true = solo notificar partidas ya parseadas por Stratz (recomendado)
# false = notificar inmediatamente aunque no estén parseadas
PARSED=true

# Modo debug (más logs en consola)
DEBUG=false

# Estadísticas por héroe (/dota stats)
STATS_MIN_GAMES=2
STATS_TAKE=100

# Hora UTC para envío diario automático de stats (HH:MM). Vacío = desactivado
STATS_TIME=20:00
